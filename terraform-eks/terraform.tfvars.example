# Copie para terraform.tfvars e ajuste. O terraform.tfvars é ignorado pelo git.

aws_region   = "us-east-1"
cluster_name = "helptech-eks"
namespace    = "helptech"

db_name     = "helptec"
db_username = "helptech"

node_instance_types = ["t3.medium"]
node_desired_size   = 2

backend_image  = "higorsantanafiec/helptech-backend:aws-v1"
frontend_image = "higorsantanafiec/helptech-frontend:aws-v2-nginx"

# serviceAccountKey.json do Firebase já existente (não copie/substitua o arquivo)
firebase_credentials_file = "C:/Users/46120/Documents/serviceAccountKey.json"

# IPs autorizados a acessar a API do EKS
eks_api_allowed_cidrs = ["SEU_IP/32"]

# Opcionais
# google_client_id     = ""
# google_client_secret = ""
# jwt_secret           = ""
# frontend_oauth2_redirect_uri = "http://<url-do-frontend>/oauth2/redirect"
